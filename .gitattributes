# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# JSON and YAML
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown
*.md text eol=lf
*.markdown text eol=lf

# Documentation
*.rst text eol=lf
*.txt text eol=lf

# Binary files
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.pt binary
*.pth binary
*.h5 binary
*.pb binary
*.bin binary
*.model binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.tiff binary
*.ico binary
*.svg text eol=lf
